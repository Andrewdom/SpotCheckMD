# MedGemma is the application image-analysis provider. Obtain the shared key
# securely from the server owner; never commit a real value.
IMAGE_ANALYSIS_PROVIDER=medgemma
MEDGEMMA_URL=https://f-15.tail1297e1.ts.net
MEDGEMMA_API_KEY=replace-with-shared-server-secret
MEDGEMMA_TIMEOUT_MS=600000

# Doctor-only dictation and provisional live captions. Keep this permanent key
# server-side; the browser receives only short-lived streaming tokens.
TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=replace-with-server-side-assemblyai-key
ASSEMBLYAI_TIMEOUT_MS=180000

# Image ingestion defaults. Uploaded JPEG/PNG files are converted to an
# oriented, metadata-stripped, lossless PNG without changing pixel dimensions.
SPOTCHECK_IMAGE_UPLOAD_MAX_MB=50
SPOTCHECK_IMAGE_MAX_PIXELS=60000000
SPOTCHECK_INFERENCE_IMAGE_MAX_MB=256

# Persistent encounter media, transcripts, and simulated EHR data. The Unraid
# container sets this to its mounted /data volume.
AURA_DATA_DIR=.aura-data
